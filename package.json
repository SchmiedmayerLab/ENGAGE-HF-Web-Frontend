    "@tanstack/react-table": "^9.1.0",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.4.0",
    "es-toolkit": "^1.50.0",
    "firebase": "^12.17.1",
    "lucide-react": "^1.30.0",
    "next-intl": "^4",
    "react": "^19",
    "react-dom": "^19",
    "use-debounce": "^10.1.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
