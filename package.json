    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "postcss": "^8",
    "prettier": "^3",
    "storybook": "^10.2.16",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7",
    "vite": "^8.2.1",
