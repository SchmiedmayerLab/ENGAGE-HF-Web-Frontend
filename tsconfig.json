{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vitest/globals"]
  },
  "include": ["vite.config.ts", "playwright.config.ts", "src/**/*.ts", "src/**/*.tsx", "e2e/**/*.ts", ".storybook/**/*.ts", ".storybook/**/*.tsx"],
  "exclude": ["node_modules"],
}
